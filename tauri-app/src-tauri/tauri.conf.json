{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pokemon Shiny Scanner",
  "version": "0.2.0",
  "identifier": "com.karuki.pokemonshinyscanner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Pokemon Shiny Scanner",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFRTc1RTRBNzM2NDdBMjEKUldRaGVtUnpTbDduSGtWY2VqWlFlMmlDVjFoSHZWTXVNbzdwalpSbSttR2p4bWlBcFVQQnd1R3YK",
      "endpoints": [
        "https://github.com/Karuki00/PokemonShinyScanner/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
